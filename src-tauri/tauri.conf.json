{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskPet4OpenClaw",
  "version": "0.1.0",
  "identifier": "com.seren.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:18900",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeskPet4OpenClaw",
        "width": 400,
        "height": 500,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "shadow": false,
        "center": true,
        "url": "http://localhost:18900"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
